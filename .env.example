# ============================================================
# Apolo AI — Configuração
# Copie para .env e preencha os valores
# ============================================================

# Modelo Ollama local (sem API key, sem custo)
# Instale com: ollama pull qwen2.5-coder:14b
OLLAMA_MODEL=qwen2.5-coder:14b

# ── Motor de LLM SOBERANO (llama.cpp embutido, dispensa o Ollama) ──
# O app inteiro é agnóstico de motor (src/providers.py). Para rodar SEM Ollama:
#   LLM_BACKEND=llamacpp
#   LLAMACPP_MODELS=apolo=models/seu-modelo.gguf   (um GGUF já cobre chat+pesado)
#   LLAMACPP_CTX=8192
# A Saúde → "Soberania" fica 🟢 quando a lib + o GGUF estão prontos.
#
# Instalar a lib (CPU): pip install --extra-index-url \
#   https://abetlen.github.io/llama-cpp-python/whl/cpu llama-cpp-python
# ATENÇÃO Python 3.14 / CPU sem AVX-512 (ex.: Ryzen Zen 2): o wheel pronto usa
# AVX-512 e crasha com 0xc000001d. Compile do fonte mirando sua CPU (precisa do
# VS Build Tools C++ + CMake; use um TMP curto tipo C:\t p/ evitar o MAX_PATH):
#   set CMAKE_ARGS=-DGGML_NATIVE=OFF -DGGML_AVX2=ON -DGGML_FMA=ON -DGGML_F16C=ON -DGGML_AVX512=OFF
#   pip install --force-reinstall --no-binary=llama-cpp-python llama-cpp-python

# Banco de dados SQLite (sessões + histórico)
DATABASE_URL=sqlite:///data/apolo.db

# ChromaDB — RAG local de exemplos de código
CHROMA_PATH=./data/chroma_db
EXAMPLES_PATH=./data/examples

# Configurações do executor de código
MAX_RETRIES=3
EXECUTION_TIMEOUT=30

# Modo Aprendizado — intervalo entre estudos autônomos (segundos)
LEARNING_INTERVAL=180

# ============================================================
# Performance / hardware — "cérebro no pico" (máquina DEDICADA)
# ============================================================
# balanced (padrão) = libera RAM entre tarefas; bom p/ uso compartilhado.
# max = mantém o modelo pesado quente + contexto grande (máquina só p/ o A.P.O.L.O.).
APOLO_PERFORMANCE=max
# Threads de inferência. Vazio = automático. Num Ryzen 6 núcleos/12 threads,
# 6 (núcleos físicos) costuma ser o ideal para CPU-only.
APOLO_NUM_THREAD=6
# Janela de contexto no perfil max (o modelo "enxerga" mais código de uma vez).
# 8192 é um bom equilíbrio em 16 GB de RAM; suba com cuidado (mais lento/mais RAM).
APOLO_NUM_CTX=8192
# Mantém o modelo pesado residente na RAM (sem recarregar do disco a cada tarefa).
# "30m", "1h" ou "-1" (sempre). Em máquina dedicada com 16 GB, "30m" é seguro.
OLLAMA_KEEP_ALIVE_HEAVY=30m
# Idle learning: após N segundos sem requisição do usuário, o aprendizado
# autônomo inicia sozinho. 0 = desativado. 600 = 10 min (padrão).
IDLE_TRIGGER=600
# API LAN: para acessar o A.P.O.L.O. de celular/tablet na rede local,
# rode o servidor com: uvicorn app:app --host 0.0.0.0 --port 8000
# Defina um token para proteger o acesso remoto (vazio = sem proteção):
# API_TOKEN=meu-token-secreto

# ============================================================
# A.P.O.L.O. Coder — autonomia e autoaprendizado
# ============================================================
# Memória de lições do Coder (aprende com as próprias tarefas).
# LESSONS_PATH=data/lessons.db
# Reflexão pós-tarefa: extrai 1 lição ao concluir (1 chamada curta no modelo leve).
# CODER_REFLECT=1
# Orçamento de contexto do loop ReAct (chars) — acima disso, observações antigas
# são compactadas para não estourar a janela (num_ctx).
# CODER_CTX_CHARS=20000
# Nº máximo de passos ler/escrever/rodar por tarefa.
# MAX_CODER_STEPS=12
# Cache do baseline da guarda de regressão (segundos) — evita re-rodar a suíte
# inteira no início de cada tarefa em sequência.
# CODER_BASELINE_TTL=900
# Máximo de lições guardadas — acima disso, as menos usadas/mais antigas são podadas.
# LESSONS_MAX=300

# ============================================================
# Soberania Total — base de conhecimento e embeddings locais
# ============================================================
# Quando SUPABASE_URL/KEY não estão configurados, o A.P.O.L.O. usa SQLite FTS5
# como base de conhecimento local (LocalKnowledge) automaticamente.
LOCAL_KNOWLEDGE_PATH=data/local_knowledge.db

# Embeddings locais via Ollama (Fase 4 — soberania total).
# Vazio = usa o default do ChromaDB (all-MiniLM-L6-v2).
# Para ativar: ollama pull nomic-embed-text
# ATENÇÃO: mudar o modelo recria a coleção (os docs existentes NÃO são migrados automaticamente).
# EMBED_MODEL=nomic-embed-text

# ============================================================
# Supabase — base de conhecimento persistente (OPCIONAL)
# Crie projeto grátis em https://supabase.com
# Settings → API → copie Project URL e anon public key
# Execute supabase/schema.sql no SQL Editor do painel
# ============================================================
SUPABASE_URL=
SUPABASE_KEY=

# ============================================================
# Agência com permissão (M6) — LEITURA do mundo, opcional
# ============================================================
# E-mail (ferramenta email.recent, scope email.read). READ-ONLY: o A.P.O.L.O.
# abre a caixa com EXAMINE, nunca marca como lido nem apaga. As credenciais
# ficam SÓ aqui (nunca no banco); o grant no painel 🔐 Permissões só habilita.
# Gmail/Outlook: use uma SENHA DE APP, não a senha principal.
IMAP_HOST=
IMAP_USER=
IMAP_PASS=
IMAP_PORT=993
# Agenda: NÃO vai no .env — autorize 'calendar.read' no painel 🔐 Permissões e
# informe ali o caminho do arquivo .ics. Idem 'files.read' (a pasta autorizada).

# ── Palavra de ativação (M5) ──────────────────────────────────
# Wake words (csv). Padrão: apolo,jarvis. Ligue a escuta pelo botão 👂 na UI.
WAKE_WORDS=apolo,jarvis
WAKE_ENABLED=0

# ── Confiabilidade do aprendizado ─────────────────────────────
# Timeout (s) das escritas no Supabase — evita que rede ruim congele o pipeline.
SUPABASE_TIMEOUT=15
# Teto (s) para persistir UM item aprendido (SQLite+Supabase+RAG).
PERSIST_TIMEOUT=45

# ── Backup criptografado em repouso (M11 11.2) ────────────────
# Senha do backup cifrado. Se definida, o A.P.O.L.O. grava 1 backup local
# cifrado por dia (a partir de BACKUP_HOUR). NUNCA é gravada em disco; sem ela o
# backup é irrecuperável. Deixe em branco para desligar o auto-backup.
BACKUP_PASSPHRASE=
# Hora local (0-23) do auto-backup diário.
BACKUP_HOUR=3
# Pasta dos backups cifrados (.apolobak).
BACKUP_DIR=data/backups

# ── Acesso remoto seguro (M11 11.3) ───────────────────────────
# Para alcançar o A.P.O.L.O. do celular na mesma rede, escute na LAN:
#   HOST=0.0.0.0
# E EXIJA um token de quem vem de fora da máquina (protege a UI inteira). Sem
# REMOTE_TOKEN, o acesso remoto fica ABERTO a qualquer um na rede — defina-o:
REMOTE_TOKEN=
# (o dono, no localhost, nunca precisa do token). Abra no celular:
#   http://SEU_IP_LAN:8000/?token=SEU_TOKEN  → o cookie fica salvo.
